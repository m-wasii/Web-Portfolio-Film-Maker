---
import site from '../../content/site.json';
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
---

<section id="contact" class="section-padding border-t border-white/10 px-6">
  <div class="mx-auto max-w-3xl">
    <div class="reveal mb-12">
      <h2 class="section-heading text-white">Let's Work.</h2>
      <p class="mt-4 text-lg text-muted">
        Have a project in mind? Get in touch — I'd love to hear about it.
      </p>
      <a
        href={`mailto:${site.email}`}
        class="mt-4 inline-block text-base text-white underline underline-offset-4"
      >
        {site.email}
      </a>
    </div>

    <form
      class="reveal space-y-4"
      action={formspreeId ? `https://formspree.io/f/${formspreeId}` : undefined}
      method="POST"
    >
      <div class="grid gap-4 md:grid-cols-2">
        <label class="block">
          <span class="mb-2 block text-sm text-muted">Name</span>
          <input
            type="text"
            name="name"
            required
            class="w-full border border-white/15 bg-white/5 px-4 py-3 text-base text-white outline-none transition focus:border-white/40"
            placeholder="Your name"
          />
        </label>
        <label class="block">
          <span class="mb-2 block text-sm text-muted">Email</span>
          <input
            type="email"
            name="email"
            required
            class="w-full border border-white/15 bg-white/5 px-4 py-3 text-base text-white outline-none transition focus:border-white/40"
            placeholder="you@email.com"
          />
        </label>
      </div>
      <label class="block">
        <span class="mb-2 block text-sm text-muted">Project type</span>
        <select
          name="project_type"
          class="w-full border border-white/15 bg-white/5 px-4 py-3 text-base text-white outline-none transition focus:border-white/40"
        >
          <option value="commercial">Commercial project</option>
          <option value="film">Film collaboration</option>
          <option value="dp">DP / Camera work</option>
          <option value="other">Other</option>
        </select>
      </label>
      <label class="block">
        <span class="mb-2 block text-sm text-muted">Message</span>
        <textarea
          name="message"
          required
          rows="5"
          class="w-full resize-y border border-white/15 bg-white/5 px-4 py-3 text-base text-white outline-none transition focus:border-white/40"
          placeholder="Tell me about your project..."
        ></textarea>
      </label>
      <button
        type="submit"
        class="border border-white px-8 py-3 text-base text-white transition hover:bg-white hover:text-black"
      >
        Send Message →
      </button>
      {!formspreeId && import.meta.env.DEV && (
        <p class="text-sm text-muted">
          Set <code class="text-white">PUBLIC_FORMSPREE_ID</code> in Cloudflare env vars to enable form delivery.
        </p>
      )}
    </form>
  </div>
</section>
