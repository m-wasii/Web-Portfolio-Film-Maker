---
import SectionHeading from '../layout/SectionHeading.astro';
import timeline from '../../content/timeline.json';
---

<section id="timeline" class="section-padding border-t border-white/10 px-6">
  <div class="mx-auto max-w-4xl">
    <SectionHeading title="The Story" />
    <ol class="relative space-y-12 border-l border-white/10 pl-8 md:pl-12">
      {timeline.map((item, index) => (
        <li class="reveal relative">
          <span class="absolute -left-[41px] top-1 h-3 w-3 rounded-full border border-white bg-black md:-left-[57px]"></span>
          <div class="flex flex-col gap-6 md:flex-row md:items-start">
            <img
              src={item.image}
              alt=""
              class="h-20 w-20 shrink-0 rounded-full object-cover grayscale"
              width="80"
              height="80"
              loading="lazy"
            />
            <div>
              <p class="text-sm text-muted">{item.date}</p>
              <h3 class="mt-1 font-display text-xl uppercase tracking-wide text-white md:text-2xl">
                {item.title}
                <span class="ml-2 text-base font-normal normal-case text-muted">· {item.type}</span>
              </h3>
              <p class="mt-3 text-base leading-relaxed text-muted">{item.description}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
